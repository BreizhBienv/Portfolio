---
interface SocialItem {
  id: string;
  label: string;
  href: string;
  path: string;
  viewBox?: string;
}

interface Props {
  items: SocialItem[];
  show?: string[];
  size?: "sm" | "md" | "lg" | "xl";
  hideOnMobile?: boolean;
  itemsGap?: string;
}

const { items, show, size = "md", hideOnMobile = false, itemsGap = "gap-3" } = Astro.props as Props;

const sizes = {
  sm: "h-6 w-6",
  md: "h-8 w-8",
  lg: "h-10 w-10",
  xl: "h-12 w-12",
};

const containerVisibility = hideOnMobile ? "hidden md:flex" : "flex";

const visibleItems = show
  ? show
      .map((id) => items.find((item) => item.id === id))
      .filter((item): item is SocialItem => Boolean(item))
  : items;
---

<div class={`${containerVisibility} flex-wrap justify-center items-center ${itemsGap}`}>
  {visibleItems.map((social) => {
    const external = social.href.startsWith("http");
    return (
      <a
        href={social.href}
        class="group text-[color:var(--color-text-secondary)]"
        {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >
        <span class="sr-only">{social.label}</span>
        <svg
          viewBox={social.viewBox ?? "0 0 24 24"}
          aria-hidden="true"
          class={`${sizes[size]} transition-colors group-hover:text-[color:var(--accent)]`}
        >
          <path fill="currentColor" d={social.path} />
        </svg>
      </a>
    );
  })}
</div>